<Window x:Class="Smart_X.frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IoT Console Base" Height="720" Width="1180"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: back button + breadcrumb, and a persistent guidance toggle -->
        <Border Grid.Row="0" Background="{StaticResource BrandDarkBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button x:Name="BackButton" Content="&#8592; Return" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BackButton_Click" Visibility="Collapsed" Margin="0,0,12,0"/>
                    <TextBlock Text="IoT Telemetry Console" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="BreadcrumbText" Grid.Column="1" Foreground="#B9BEDA" VerticalAlignment="Center" Margin="16,0,0,0"/>

                <ToggleButton x:Name="GuidanceToggle" Grid.Column="2" Content="Guidance: On" IsChecked="True"
                              Checked="GuidanceToggle_Changed" Unchecked="GuidanceToggle_Changed"
                              Padding="10,6" Background="#33375A" Foreground="White" BorderThickness="0"
                              ToolTip="Show or hide contextual tips and inline help throughout the app."/>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
