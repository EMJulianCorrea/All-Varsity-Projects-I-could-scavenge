<Page x:Class="Smart_X.frontend.Views.CommandStream"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Real-Time Command Stream and History"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <Grid Background="{StaticResource SurfaceBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Toolbar: search, live toggle, burst, stats ============ -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Search by category, with placeholder text overlaid -->
                    <Grid Width="260" Margin="0,0,12,0">
                        <TextBox x:Name="SearchBox" Margin="0" TextChanged="SearchBox_TextChanged"
                                 ToolTip="Filter every panel by sensor category, e.g. 'temp' matches Temperature."
                                 ToolTipService.ShowOnDisabled="True"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="🔍  Search sensors by category..."
                                   Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <ToggleButton x:Name="LiveToggle" Content="● Live" Padding="14,8" Margin="0,0,12,0"
                                  Checked="LiveToggle_Changed" Unchecked="LiveToggle_Changed"
                                  ToolTip="Pause or resume the automatic refresh of this dashboard."/>

                    <Button Content="Simulate Burst" Style="{StaticResource PrimaryButtonStyle}"
                            Click="Burst_Click"
                            ToolTip="Send 3 synthetic readings per visible sensor in one batch, to watch the queue and alerts react."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ActionStatusText" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SearchHintText" Style="{StaticResource GuidanceHintStyle}" Margin="0"
                               Text="Tip: searching filters the sensor list, live stream, alerts and active errors together."/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock x:Name="ConnectionText" Text="Connecting..." FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="StatsText" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Three-column dashboard ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: sensors + manual override -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sensors" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <DataGrid x:Name="SensorGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  BorderThickness="0" Background="Transparent" RowHeight="30"
                                  SelectionChanged="SensorGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="85"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding LastStatus}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Manual Override" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SelectedSensorText" Text="Select a sensor above." FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="COMMAND" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CommandBox"
                                  ToolTip="Reset clears the sensor's error state. Calibrate flags it as calibrating. Disable blocks its telemetry. Enable resumes it."/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply Override" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyOverride_Click"/>
                            <Button Content="Undo Last" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="UndoOverride_Click"
                                    ToolTip="Reverse the most recent override, whichever sensor it was applied to."/>
                        </StackPanel>

                        <TextBlock x:Name="OverrideHintText" Style="{StaticResource GuidanceHintStyle}" Margin="0,10,0,0"
                                   Text="Tip: overrides are stacked, so Undo Last always reverses the newest one first."/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CENTER: live stream -->
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Live Command Stream  (newest first)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <DataGrid x:Name="StreamGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              BorderThickness="0" Background="Transparent" RowHeight="28"
                              FontFamily="Consolas" FontSize="12">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnomalous}" Value="True">
                                        <Setter Property="Background" Value="#FDECEC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="110"/>
                            <DataGridTextColumn Header="Sensor" Binding="{Binding SensorId}" Width="120"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- RIGHT: alerts, errors, override history -->
            <Grid Grid.Column="2" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Critical Alerts" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="AlertsHintText" DockPanel.Dock="Top" Style="{StaticResource GuidanceHintStyle}" Margin="0,2,0,6"
                                   Text="Most severe first. A repeat anomaly on the same sensor escalates to Critical."/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Acknowledge Next" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Click="AckAlert_Click"
                                    ToolTip="Remove the most severe outstanding alert."/>
                            <Button Content="Clear All" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="8,0,0,0" Click="ClearAlerts_Click"/>
                        </StackPanel>
                        <ListBox x:Name="AlertList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Badge" Background="{StaticResource WarnBrush}" CornerRadius="8" Padding="6,1"
                                                Margin="0,0,8,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SeverityLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding SensorId}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="1">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Active Error States" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <ListBox x:Name="ErrorList" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DangerBrush}"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Override History" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <ListBox x:Name="OverrideList" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="11" DisplayMemberPath="Display"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
