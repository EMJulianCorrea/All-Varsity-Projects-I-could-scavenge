<Window x:Class="Smart_X.frontend.Views.AttachLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attach Hardware Log"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="22" Margin="16">
        <StackPanel>
            <TextBlock Text="Attach a hardware log" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="TargetText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,18"/>

            <TextBlock Text="1. CHOOSE A FILE" Style="{StaticResource FieldLabelStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathBox" IsReadOnly="True" Margin="0,0,0,6"
                         ToolTip="The file you picked. Use Browse to choose a different one."/>
                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,6" Click="Browse_Click"
                        ToolTip="Pick a log file from your computer."/>
            </Grid>
            <TextBlock x:Name="FileInfoText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="2. CLASSIFY IT" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="ClassificationBox" Margin="0,0,0,6"
                      ToolTip="What kind of log this is. It's suggested for you, but you can change it."/>
            <TextBlock x:Name="SuggestionText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Choose a file and a classification will be suggested."/>
            <TextBlock x:Name="TipText" Style="{StaticResource GuidanceHintStyle}" Margin="0,0,0,16"
                       Text="Tip: classifying logs (for example Error or Calibration) makes the right one quick to find later when troubleshooting a spike or a disconnect."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"/>
                <Button x:Name="UploadButton" Content="3. Upload" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,0,0" Click="Upload_Click" IsEnabled="False"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>
