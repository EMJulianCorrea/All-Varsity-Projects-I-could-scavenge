<Window x:Class="Smart_X.frontend.Views.SensorLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Logs"
        Width="820" Height="520" MinWidth="660" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}"/>
            <ComboBox x:Name="FilterBox" Width="190" Margin="0,0,16,0" SelectionChanged="Filter_Changed"
                      ToolTip="Only show logs with this classification."/>
            <Button Content="Attach Log..." Style="{StaticResource PrimaryButtonStyle}" Click="Attach_Click"
                    ToolTip="Choose a file, classify it, and upload it to this sensor."/>
            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="Refresh_Click"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="4">
            <Grid>
                <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          BorderThickness="0" Background="Transparent" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="Classification" Binding="{Binding ClassificationText}" Width="130"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"/>
                        <DataGridTextColumn Header="Uploaded" Binding="{Binding UploadedText}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Download..." Style="{StaticResource SecondaryButtonStyle}" Click="Download_Click"
                    ToolTip="Save the selected log to your computer."/>
            <Button Content="Delete" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="Delete_Click"
                    ToolTip="Permanently remove the selected log."/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="HintText" Style="{StaticResource GuidanceHintStyle}" Margin="0,4,0,0"
                       Text="Tip: select a row, then Download to save a copy under its original name. Use the filter to jump straight to Error logs."/>
        </StackPanel>
    </Grid>
</Window>
