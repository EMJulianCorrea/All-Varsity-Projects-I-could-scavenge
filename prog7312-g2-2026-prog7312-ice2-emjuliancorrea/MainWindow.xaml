<Window x:Class="PlaylistApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlist" Height="520" Width="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Now playing -->
        <Border Grid.Row="0" Background="#222" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="NOW PLAYING" Foreground="#999" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="NowPlayingText" Text="Scanning..."
                           Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Add track form -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TitleBox" Grid.Column="0" Margin="0,0,4,0"
                     Tag="Title" ToolTip="Track title"/>
            <TextBox x:Name="ArtistBox" Grid.Column="1" Margin="0,0,4,0"
                     Tag="Artist" ToolTip="Artist"/>
            <Button x:Name="AddButton" Grid.Column="2" Content="Add Track"
                    Padding="10,4" Click="AddButton_Click"/>
        </Grid>

        <!-- Playlist -->
        <ListBox x:Name="PlaylistBox" Grid.Row="2" Margin="0,0,0,10"
                 SelectionMode="Single"
                 MouseDoubleClick="PlaylistBox_MouseDoubleClick"/>

        <!-- Transport controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Button x:Name="PrevButton" Content="⏮ Prev" Padding="12,6" Margin="4" Click="PrevButton_Click"/>
            <Button x:Name="NextButton" Content="Next ⏭" Padding="12,6" Margin="4" Click="NextButton_Click"/>
            <Button x:Name="ShuffleButton" Content="🔀 Shuffle" Padding="12,6" Margin="4" Click="ShuffleButton_Click"/>
        </StackPanel>

        <!-- Remove -->
        <Button x:Name="RemoveButton" Grid.Row="4" Content="Remove Selected Track"
                Padding="10,6" Click="RemoveButton_Click"/>
    </Grid>
</Window>
