<Page x:Class="Smart_X.frontend.Views.RegisterDevice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sensor Data Ingestion and Telemetry"
      Loaded="Page_Loaded">
    <Grid Background="{StaticResource SurfaceBrush}"
          Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Sensor Registration / Edit -->
        <Border Grid.Column="0"
                Background="{StaticResource CardBrush}"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,16,0">
            <StackPanel>
                <TextBlock x:Name="FormHeaderText"
                           Text="Register a Sensor"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,14"/>

                <TextBlock Text="IDENTIFICATION"
                           Style="{StaticResource FieldLabelStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SensorIdBox"
                             Grid.Column="0"
                             ToolTip="A unique ID for the sensor (e.g. SENSOR-042)"/>
                    <Button x:Name="GenerateIdButton"
                            Grid.Column="1"
                            Content="Generate"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,12"
                            Click="GenerateId_Click"
                            ToolTip="Auto-generate an unique ID that no other device uses"/>
                </Grid>
                <TextBlock x:Name="IdGuidanceHint"
                           Style="{StaticResource GuidanceHintStyle}"
                           Text="Tip: add easy to recognize words and/or numbers to easily associate and find the sensor later."/>

                <TextBlock Text="DEPLOYMENT LOCATION"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="LocationBox"
                         ToolTip="Where the sensor is physically deployed (e.g. 'Warehouse 3 - Bay 2')"/>
                <TextBlock x:Name="LocationGuidanceHint"
                           Style="{StaticResource GuidanceHintStyle}"
                           Text="Tip: a sensor will be easier to find the more specific and detailed the location is"/>

                <TextBlock Text="CATEGORY"
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="CategoryBox"
                          SelectedIndex="0"
                          ToolTip="The kind of measurement the sensor reports (e.g Temperature)"/>
                <TextBlock x:Name="CategoryGuidanceHint"
                           Style="{StaticResource GuidanceHintStyle}"
                           Text="Tip: the category determines what the normal-range thresholds and anomaly rules for the sensor will be."/>

                <CheckBox x:Name="SimulatedCheckBox"
                          Content="Mark as simulated sensor"
                          IsChecked="True"
                          Margin="0,4,0,16"
                          ToolTip="Simulated sensors generate synthetic readings for testing dashboards without any real, physical hardware"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveButton"
                            Content="Register Sensor"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"/>
                    <Button x:Name="CancelEditButton"
                            Content="Cancel Edit"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="CancelEdit_Click"
                            Visibility="Collapsed"/>
                </StackPanel>

                <TextBlock x:Name="RegistrationStatusText"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Sensor editing -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">
                <TextBlock Text="Registered Sensors"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="16,0,0,0"
                        Click="Refresh_Click"
                        ToolTip="Reload the sensor list from the API."/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="4">
                <DataGrid x:Name="SensorGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="34"
                          SelectionChanged="SensorGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Location"
                                            Binding="{Binding DeploymentLocation}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding LastStatus}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Registered (UTC)"
                                            Binding="{Binding RegisteredAt}"
                                            Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2"
                        Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Simulate Telemetry Reading"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SimulateTelemetry_Click"
                            ToolTip="Send one synthetic reading for the selected sensor (will occasionally simulate an anomalous spike)"/>
                    <Button Content="Attach Hardware Log"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="AttachLog_Click"
                            ToolTip="Choose a log file from your disk and attach it to the selected sensor's profile"/>
                    <Button Content="Edit Selected"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="EditSelected_Click"
                            ToolTip="Load the selected sensor's location and category into the form on the left for editing"/>
                    <Button Content="Delete Selected"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="DeleteSelected_Click"
                            ToolTip="Permanently remove the selected sensor and its history"/>
                </StackPanel>
                <TextBlock x:Name="SelectedSensorHint"
                           Style="{StaticResource GuidanceHintStyle}"
                           Text="Select a sensor above to simulate telemetry, attach a log, edit, or delete it."
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"/>
            </StackPanel>

            <Border Grid.Row="3"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Live Telemetry Feed"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <ListBox x:Name="TelemetryFeed"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Consolas"
                             FontSize="12"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Guidance settings -->
        <Border x:Name="GuidancePanel"
                Grid.Column="2"
                Background="#101223"
                CornerRadius="10"
                Padding="18"
                Margin="16,0,0,0">
            <StackPanel>
                <TextBlock Text="💡 Guidance"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="GuidanceBody"
                           Foreground="#C9CCE3"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Text="Start by registering a sensor on the left. 
                           Once it appears in the table below, 
                           select it to simulate readings, attach a hardware log file, edit its details, or delete it."/>

                <Separator Margin="0,16"
                           Background="#2A2D4A"/>

                <TextBlock Text="Reading the status column..."
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,4">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource OkBrush}"
                             Margin="0,0,6,0"/>
                    <TextBlock Text="NOMINAL (Reading id within expected range)"
                               Foreground="#C9CCE3"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,4">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource DangerBrush}"
                             Margin="0,0,6,0"/>
                    <TextBlock Text="ANOMALY DETECTED (Investigate the spike below)"
                               Foreground="#C9CCE3"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Separator Margin="0,16"
                           Background="#2A2D4A"/>
                <TextBlock Text="Troubleshooting a spike..."
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <TextBlock Foreground="#C9CCE3"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="1) Check the live feed for how far the value deviates from any previous readings.&#10;
                           2) Attach the sensor's hardware log for the same sensor.&#10;
                           3) If readings stop working entirely, treat it as the sensor disconnecting rather than there being no reading."/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
